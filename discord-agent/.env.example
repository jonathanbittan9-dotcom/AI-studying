# Copy this file to .env and fill in real values. Never commit .env.

# Discord bot token, from https://discord.com/developers/applications
DISCORD_TOKEN=
# Your server's ID (right-click the server > Copy Server ID). Slash commands
# sync instantly to this server; leave empty to register them globally.
GUILD_ID=

# Which LLM to use, in "provider:model" format.
MODEL=ollama:qwen3:8b
# MODEL=anthropic:claude-sonnet-5-5
# MODEL=google_genai:gemini-2.5-flash
# MODEL=groq:openai/gpt-oss-120b

# API key for the provider above (not needed for Ollama).
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# Postgres (conversation memory) - docker compose starts it on port 5433.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://discord_agent:change-me@localhost:5433/discord_agent
