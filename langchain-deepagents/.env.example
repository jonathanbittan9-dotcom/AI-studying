# Copy this file to .env and fill in real values. Never commit .env.

# Which LLM to use, in "provider:model" format.
MODEL=anthropic:claude-sonnet-5-5
# MODEL=google_genai:gemini-2.5-flash

ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Postgres (conversation memory) - docker compose starts it on port 5433.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://raider:change-me@localhost:5433/raider
